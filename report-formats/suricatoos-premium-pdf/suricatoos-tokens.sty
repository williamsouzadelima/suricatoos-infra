% ---------------------------------------------------------------------------
% Severity lookup.
%
% \sevcolor{alto} -> the ramp colour, \sevbg{alto} -> the soft fill.  Callers
% pass the severity key as data (it comes straight from the XSLT), so an unknown
% key must degrade to something readable rather than blow up the run.
% ---------------------------------------------------------------------------
\newcommand{\sevcolor}[1]{%
  \ifcsname\string\color@#1\endcsname #1\else muted\fi}
\newcommand{\sevbg}[1]{%
  \ifcsname\string\color@#1bg\endcsname #1bg\else neutrobg\fi}

% ---------------------------------------------------------------------------
% Text helpers.
%
% \lbl is the signature of this design: monospace, upper case, widely tracked.
% Letter-spacing is quoted in the spec in px of tracking; \textls takes
% thousandths of an em, and 1.5-3px at these sizes lands around 180-260.
% ---------------------------------------------------------------------------
\newcommand{\suritrack}{220}
\newcommand{\lbl}[1]{{\suriMono\textls[\suritrack]{\MakeUppercase{#1}}}}
% \lblc{colour}{text} and \lbls{px}{text} for the coloured / resized variants.
\newcommand{\lblc}[2]{{\color{#1}\lbl{#2}}}
\newcommand{\lbls}[2]{{\suriFS{#1}{#1}\lbl{#2}}}
\newcommand{\lblcs}[3]{{\color{#1}\suriFS{#2}{#2}\lbl{#3}}}

% Monospace data (IPs, ports, CVSS, timestamps) — never tracked, never upper.
\newcommand{\dat}[1]{{\suriMono #1}}

\endinput
