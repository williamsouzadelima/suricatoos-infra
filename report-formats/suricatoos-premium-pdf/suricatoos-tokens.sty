% suricatoos-tokens.sty — design tokens for the Suricatoos vulnerability report.
%
% This is the CONTRACT every other module of the report design system builds on:
% the type stack, the colour palette, the px->pt scale and the low-level text
% helpers.  Nothing here draws anything; it only names things.
%
% Engine: pdflatex ONLY.  The production gvmd container has no luaotfload, so
% fontspec/lualatex is not an option; IBM Plex is loaded as Type1 through the
% CTAN `plex' package, whose TDS subtree ships with the report format bundle and
% is put on TEXMFHOME by the `generate' script.
%
% Copyright (C) 2026 Suricatoos.  SPDX-License-Identifier: GPL-2.0-or-later
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{suricatoos-tokens}[2026/08/22 Suricatoos report design tokens]

\RequirePackage{xcolor}
\RequirePackage{letterspace}

% ---------------------------------------------------------------------------
% Type stack.
%
% \pdfmapfile MUST come before the plex packages: the font map is not installed
% in the container's texmf tree, it travels with the bundle, so pdftex has to be
% told about it explicitly or every Plex face silently falls back to Latin
% Modern.  `sfdefault' makes Plex Sans the document font; `semibold' enables the
% sb series used by section titles and card headings.
% ---------------------------------------------------------------------------
\pdfmapfile{+plex.map}
\RequirePackage[type1,sfdefault,semibold]{plex-sans}
\RequirePackage[type1]{plex-mono}

\newcommand{\suriSans}{\sffamily}
\newcommand{\suriMono}{\ttfamily}
% Semibold is a real face (plxSans-SmBld), not a synthetic weight.
\newcommand{\suriSB}{\fontseries{sb}\selectfont}

% ---------------------------------------------------------------------------
% px -> pt.
%
% The design was authored in CSS pixels on an A4 page (794x1123 px); the PDF page
% is 595x842 pt.  The ratio is 0.75, i.e. the usual 96dpi px.  Every size in the
% spec is quoted in px, so keep converting through here instead of hand-rounding
% at each call site.
% ---------------------------------------------------------------------------
\newcommand{\suripx}[1]{\dimexpr#1pt*3/4\relax}
% \suriFS{size-in-px}{leading-in-px}
\newcommand{\suriFS}[2]{\fontsize{\suripx{#1}}{\suripx{#2}}\selectfont}

