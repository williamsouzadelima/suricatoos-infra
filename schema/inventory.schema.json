{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://suricatoos.dev/schema/inventory.schema.json",
  "title": "Suricatoos Agent — Inventory",
  "description": "Normalized, OS-independent inventory emitted per collection cycle. Source of truth mirrored by agent/internal/inventory (Go). schema_version is bumped with agent/internal/inventory.SchemaVersion.",
  "type": "object",
  "required": ["schema_version", "agent", "collected_at", "os", "packages"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$", "description": "inventory contract; any 1.x is accepted (minor bumps add optional fields). Current: 1.1.0." },
    "agent": {
      "type": "object",
      "required": ["agent_id", "agent_version", "hostname"],
      "additionalProperties": false,
      "properties": {
        "agent_id": { "type": "string", "description": "machine-id derived, stable across reboot" },
        "agent_version": { "type": "string" },
        "hostname": { "type": "string" },
        "scope": { "type": "string", "description": "tenant/policy bound to the mTLS cert" }
      }
    },
    "collected_at": { "type": "string", "format": "date-time" },
    "os": {
      "type": "object",
      "required": ["family", "release", "arch"],
      "additionalProperties": false,
      "properties": {
        "family": { "enum": ["linux", "darwin", "windows"] },
        "distro": { "type": "string" },
        "release": { "type": "string" },
        "arch": { "type": "string" },
        "kernel": { "type": "string" },
        "build": { "type": "string", "description": "Windows build number, e.g. 19045" },
        "ubr": { "type": "string", "description": "Windows Update Build Revision, e.g. 4291; with build = precise patch level for MSRC" }
      }
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "version", "source"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "version": { "type": "string" },
          "arch": { "type": "string" },
          "source": { "enum": ["dpkg", "rpm", "pkgutil", "app-bundle", "homebrew", "registry", "winget"] },
          "full_name": { "type": "string", "description": "Notus-style name-version-release.arch (Linux)" }
        }
      }
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "listening_ports_local": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["port", "proto"],
            "additionalProperties": false,
            "properties": {
              "port": { "type": "integer", "minimum": 0, "maximum": 65535 },
              "proto": { "enum": ["tcp", "udp"] },
              "process": { "type": "string" }
            }
          }
        },
        "services": { "type": "array", "items": { "type": "string" } },
        "installed_kbs": {
          "type": "array",
          "description": "Windows KB identifiers already installed (MSRC supersedence evidence).",
          "items": { "type": "string" }
        },
        "missing_updates": {
          "type": "array",
          "description": "Updates the host reports as applicable-but-not-installed (Windows Update Agent). Severity/CVE are carried verbatim from the source; the agent never judges them.",
          "items": {
            "type": "object",
            "required": ["kb"],
            "additionalProperties": false,
            "properties": {
              "kb": { "type": "string" },
              "title": { "type": "string" },
              "msrc_severity": { "type": "string" },
              "reboot_required": { "type": "boolean" },
              "categories": { "type": "array", "items": { "type": "string" } },
              "update_id": { "type": "string" },
              "source": { "type": "string", "description": "e.g. microsoft-update, wsus" }
            }
          }
        },
        "management": {
          "type": "object",
          "description": "Central-management posture (Windows), so the cloud avoids proposing a local fix a GPO/MDM would revert.",
          "additionalProperties": false,
          "properties": {
            "domain_joined": { "type": "boolean" },
            "wsus_configured": { "type": "boolean" },
            "wsus_url": { "type": "string" },
            "intune_enrolled": { "type": "boolean" }
          }
        }
      }
    },
    "cycle_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "force": { "type": "boolean" }
  }
}
